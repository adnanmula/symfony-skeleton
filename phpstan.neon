parameters:
    level: 6
    treatPhpDocTypesAsCertain: false
    paths:
        -   src
        -   tests
    excludePaths:
        -   public/*
        -   src/Kernel.php
        -   config/bootstrap.php
        -   config/reference.php
    ignoreErrors:
        - identifier: missingType.iterableValue
        -
            identifier: missingType.parameter
            paths:
                - src/Application/*/*/*Command.php
