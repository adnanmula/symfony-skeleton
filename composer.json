{
    "name": "adnanmula/symfony-skeleton",
    "description": "Symfony skeleton",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "adnanmula/telegram-send-message": "^0.0.5",
        "beberlei/assert": "^3.3",
        "doctrine/dbal": "^3.9",
        "eleirbag89/telegrambotphp": "^1.4",
        "ramsey/uuid": "^4.0",
        "robmorgan/phinx": "^0.16",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/messenger": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "adnanmula/coding-standard": "^0.0.13",
        "behat/behat": "^3.13",
        "friends-of-behat/symfony-extension": "^2.4",
        "infection/infection": "^0.31",
        "phpro/grumphp": "^2.9",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "bin-dir": "bin",
        "platform-check": false,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "phpro/grumphp": true,
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "AdnanMula\\Skeleton\\": "src/",
            "AdnanMula\\Skeleton\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AdnanMula\\Skeleton\\Tests\\": "tests/"
        }
    },
    "replace": {
        "paragonie/random_compat": "2.*",
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php71": "*",
        "symfony/polyfill-php70": "*",
        "symfony/polyfill-php56": "*"
    },
    "scripts": {
      "auto-scripts": {
        "cache:clear": "symfony-cmd",
        "assets:install %PUBLIC_DIR%": "symfony-cmd"
      },
      "post-install-cmd": [
        "@auto-scripts"
      ],
      "post-update-cmd": [
        "@auto-scripts"
      ],
      "post-autoload-dump": [
        "rm -rf .git/hooks",
        "cp -r scripts/git-hooks .git/hooks"
      ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        }
    }
}
